# Set these values in the Coolify Django service environment.
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<coolify-backend-domain>
DJANGO_CORS_ALLOWED_ORIGINS=https://<frontend-domain>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<frontend-domain>
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_PROXY_SSL_HEADER=True
DJANGO_DB_CONN_MAX_AGE=0
RUN_MIGRATIONS=False
DATABASE_URL=<existing-supabase-postgresql-connection-string>
FRONTEND_BASE_URL=https://<frontend-domain>
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=/app/media

# Supabase Storage S3-compatible API. Keep these values only in the backend host.
SUPABASE_S3_ENDPOINT=https://<existing-supabase-project>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=replace-with-supabase-storage-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-supabase-storage-secret-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_PUBLIC_URL=https://<existing-supabase-project>.supabase.co/storage/v1/object/public/media
SUPABASE_S3_REGION=us-east-1

SUPABASE_URL=https://<existing-supabase-project>.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWKS_URL=https://<existing-supabase-project>.supabase.co/auth/v1/.well-known/jwks.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email (branded verification emails).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ethiopianstartupschool.com
EMAIL_TIMEOUT=30
